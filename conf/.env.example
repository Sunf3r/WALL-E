# .env: Here I keep sensitive content like keys, IDs, IPs, etc
# and other environment variables
TZ='America/Sao_Paulo' # timezone

# ========== { Database } ==========
# Drizzle supports PostgreSQL, MySQL, SQLite and others,
# but I use PostgreSQL and some things could not be easy to set up on other DBs.
# DATABASE_URL='postgresql://role:password@host:port/db'



# ========== { BOT } ========== 
# Bot developers/owners lid
# split every lid by a |
DEVS='lid01|lid02|lid03'

# group Ids for group announcement 
# split every id by a |
GROUPS1='' # Groups to be announced by #diurno
GROUPS2='' # and by #noturno
#grupos will announce to all these groups


# ========== { Optional } ==========
# These keys are only necessary to specific things.
# Google Gemini API is necessary to use AI generate content features
GEMINI='get a key on https://aistudio.google.com/app/apikey'

# ========== { Telegram bridge } ==========
# Required to mirror WhatsApp chats into a Telegram forum supergroup.
# TELEGRAM_BOT_TOKEN='123:abc'
# TELEGRAM_SUPERGROUP_ID='-1001234567890'
# RATE_LIMIT_MS='1000'